# Snowflake credentials — copy this file to .env and fill in your values
# NEVER commit .env to Git

SNOWFLAKE_ACCOUNT=<YOUR_ACCOUNT>         # e.g. XCBWHYD-PJ36074
SNOWFLAKE_USER=<YOUR_USERNAME>
SNOWFLAKE_PASSWORD=<YOUR_PASSWORD>
SNOWFLAKE_WAREHOUSE=MINING_WH
SNOWFLAKE_DATABASE=MINING_DB           # normal tables database name
SNOWFLAKE_ICEBERG_DATABASE=MINING_ICEBERG  # Iceberg tables database name
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Authentication method — choose one:
#   password          → plain password (no MFA)
#   username_password_mfa → password + prompts for TOTP at runtime
#   externalbrowser   → opens browser for SSO/MFA (recommended)
SNOWFLAKE_AUTHENTICATOR=username_password_mfa
